{
  "title": "OpenLDAP",
  "uid": "openldap-exporter",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(openldap_up, group)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(openldap_up{group=~\"$group\", cluster=~\"$cluster\"}, target)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(openldap_up, cluster)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "regex": ""
      },
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "resets(openldap_start_time_seconds{target=~\"$target\", cluster=~\"$cluster\"}[10m]) > 0",
        "titleFormat": "{{target}} restarted"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Nodes up",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(openldap_up{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\"})",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "description": "OpenLDAP servers answering, across every directory."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Clusters",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (cluster) (openldap_up{group=~\"$group\", cluster=~\"$cluster\"}))",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "description": "Directories being monitored. Each has its own replication group."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Clusters in sync",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(openldap_replication_group_in_sync{group=~\"$group\", cluster=~\"$cluster\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "description": "Clusters where every node is within the replication tolerance."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Worst replication lag",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max(openldap_replication_lag_seconds{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Links not seen on provider",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "syncrepl consumer links whose provider shows no matching connection - the blackholed-link signature: config looks correct and the consumer socket can look healthy while the provider never received it.",
      "targets": [
        {
          "expr": "sum(openldap_syncrepl_link_seen_on_provider{group=~\"$group\", cluster=~\"$cluster\"} == 0) OR vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Config drift findings",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "no-keepalive + finite-retry + self-reference + read-only + multiprovider-off, summed.",
      "targets": [
        {
          "expr": "sum(openldap_syncrepl_consumer_keepalive{group=~\"$group\", cluster=~\"$cluster\"} == 0) + sum(openldap_syncrepl_consumer_retry_forever{group=~\"$group\", cluster=~\"$cluster\"} == 0) + sum(openldap_syncrepl_consumer_self_reference{group=~\"$group\", cluster=~\"$cluster\"} == 1) + sum(openldap_database_readonly{group=~\"$group\", cluster=~\"$cluster\"} == 1) OR vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Nodes",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "One row per OpenLDAP server: is it up, how many records does it hold, and how many servers have contributed changes. Records and Change sets should agree within a cluster.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, group, target) (openldap_up{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, group, target) (openldap_entries{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\", name=\"all\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, group, target) (openldap_context_csn_sids{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "cluster": "Cluster",
              "group": "Group",
              "target": "Node",
              "Value #A": "Up",
              "Value #B": "Records",
              "Value #C": "Change sets"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "up",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 900,
      "type": "table",
      "title": "Cluster health",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "One row per monitored directory: how many nodes, how many are up, whether all are in sync, worst lag, and links the provider has not seen.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (cluster) (openldap_up)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster) (openldap_up)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min by (cluster) (openldap_replication_in_sync)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster) (openldap_replication_lag_seconds)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster) (openldap_syncrepl_link_seen_on_provider == 0)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "cluster": "Cluster",
              "Value #A": "Targets",
              "Value #B": "Up",
              "Value #C": "In sync",
              "Value #D": "Worst lag (s)",
              "Value #E": "Links not seen"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Topology",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 401,
      "type": "table",
      "title": "Replication links",
      "description": "Live architecture diagram, built from the same metrics as every other panel - not a static drawing. Nodes are every scraped target; an edge is one syncrepl consumer -> provider link, drawn from the provider's own cn=Connections (the same source as the 'Links not seen on provider' panel above), not from the consumer's config alone. Click a node or edge for detail. Ring fill on a node = openldap_up (full = up, empty = down). This panel's exact visual styling (ring/edge colors, thresholds) may need one manual pass in Grafana's panel editor after import - the node/edge data itself is exactly what the queries below return, but Node Graph's finer color knobs are easiest to get exactly right by eye in the editor rather than blind JSON.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "edges",
          "format": "table",
          "instant": true,
          "expr": "openldap_syncrepl_link_seen_on_provider{group=~\"$group\", cluster=~\"$cluster\"}"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "link_id": true
            },
            "renameByName": {
              "consumer": "Consumer",
              "provider": "Provider",
              "rid": "RID",
              "group": "Group",
              "cluster": "Cluster",
              "Value": "Link seen"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Link seen"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "NO",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "yes",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Replication",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      }
    },
    {
      "id": 101,
      "type": "timeseries",
      "title": "Replication lag by sid",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "How far each target is behind the newest known value for each contextCSN sid within its group.",
      "targets": [
        {
          "expr": "openldap_replication_lag_seconds{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\"}",
          "legendFormat": "{{target}} sid={{sid}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        }
      }
    },
    {
      "id": 102,
      "type": "state-timeline",
      "title": "In sync (by target, per suffix)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "openldap_replication_in_sync{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\"}",
          "legendFormat": "{{target}} {{suffix}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OUT OF SYNC",
                  "color": "red"
                },
                "1": {
                  "text": "in sync",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 103,
      "type": "table",
      "title": "Sids missing per target",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "A sid another group member carries that this target does not. A QA-group sid missing on a prod-only target is the one-way guarantee working as designed - check role before alerting.",
      "targets": [
        {
          "expr": "openldap_replication_sid_missing{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\"} == 1",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            }
          }
        }
      ]
    },
    {
      "id": 104,
      "type": "table",
      "title": "Syncrepl consumer links vs provider reality",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "0 means the provider holds no connection from this consumer, even though the consumer's own socket may look healthy. See runbook: 5.HISTORY-DEBUG-QA-SYNC.md.",
      "targets": [
        {
          "expr": "openldap_syncrepl_link_seen_on_provider{group=~\"$group\", cluster=~\"$cluster\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "seen"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "seen"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "cn=Monitor",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      }
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "Operations / sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (target, operation) (rate(openldap_operations_completed_total{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\"}[5m]))",
          "legendFormat": "{{target}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 202,
      "type": "timeseries",
      "title": "Current connections",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "openldap_connections_current{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\"}",
          "legendFormat": "{{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 203,
      "type": "timeseries",
      "title": "Thread pool: active / max",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "openldap_threads{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\", kind=\"active\"}",
          "legendFormat": "{{target}} active"
        },
        {
          "expr": "openldap_threads{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\", kind=\"max\"}",
          "legendFormat": "{{target}} max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        }
      }
    },
    {
      "id": 204,
      "type": "timeseries",
      "title": "Pending operations",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "openldap_threads{group=~\"$group\", cluster=~\"$cluster\", target=~\"$target\", kind=\"pending\"}",
          "legendFormat": "{{target}}"
